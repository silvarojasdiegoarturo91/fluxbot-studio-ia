# ================================================================
# FLUXBOT STUDIO IA (SHOPIFY ADMIN APP) - PRODUCTION Environment
# ================================================================
# Template for the production deployment on Contabo.
#
# PRODUCTION RUNTIME (verified live):
#   - systemd service : fluxbot-studio-ia.service
#   - env file        : /etc/fluxbot-studio-ia.env  (root-only, chmod 600)
#   - app identity    : fluxbot-studio-ia
#     client ID       : 3e33f15eca7b32e62ea7137311172df5
#   - app URL         : https://app.fluxbotia.com
#   - PORT            : 3000
#   - healthcheck     : https://app.fluxbotia.com/healthcheck
#   - start command   : `npm run start` -> react-router-serve ./build/server/index.js
#
# Copy this template to /etc/fluxbot-studio-ia.env and replace every
# placeholder. NEVER commit real secrets.

# ================================================================
# SHOPIFY CREDENTIALS
# ================================================================
# Production app: fluxbot-studio-ia (client 3e33f15eca7b32e62ea7137311172df5)
SHOPIFY_API_KEY=3e33f15eca7b32e62ea7137311172df5
SHOPIFY_API_SECRET=shpss_production_secret_here

# OAuth scopes
SCOPES=read_products,write_products,read_orders,read_customers,read_content,read_locales,read_online_store_pages

# Public app URL for production deploys.
SHOPIFY_APP_URL=https://app.fluxbotia.com

# Development store URL
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_DEV_STORE_URL=your-store.myshopify.com

# Same as SHOPIFY_API_SECRET, kept separate for clarity
SHOPIFY_WEBHOOK_SECRET=shpss_production_secret_here

# ================================================================
# DATABASE
# ================================================================
# PostgreSQL connection string (Frontend - Shopify data only)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://fluxbot_user:your_secure_password@localhost:5432/fluxbot_prod?schema=public

# ================================================================
# REDIS (cache, queues, rate limiting)
# ================================================================
REDIS_URL=redis://localhost:6379

# ================================================================
# IA GATEWAY
# ================================================================
# Controls which AI implementation is used for chat processing.
#   remote (default) — delegates to fluxbot-studio-back-ia via HTTP.
#   local            — calls AIOrchestrationService directly in this process.
# In production this app runs in `remote` mode; the backend owns provider keys.
IA_EXECUTION_MODE=remote

# Backend IA service (only needed when IA_EXECUTION_MODE=remote)
IA_BACKEND_URL=https://backend.fluxbotia.com
IA_BACKEND_API_KEY=your_secure_ia_backend_api_key

# ================================================================
# OMNICHANNEL BRIDGE (Phase 3)
# ================================================================
OMNICHANNEL_BRIDGE_URL=https://your-omnichannel-bridge.example.com
OMNICHANNEL_BRIDGE_TOKEN=your_secure_bridge_token
OMNICHANNEL_BRIDGE_WEBHOOK_SECRET=your_secure_callback_hmac_secret
OMNICHANNEL_CALLBACK_MAX_AGE_SECONDS=300

# ================================================================
# APP CONFIGURATION
# ================================================================
NODE_ENV=production

# MUST be >= 32 characters
SESSION_SECRET=your_secure_session_secret_at_least_32_chars

# ================================================================
# FEATURE FLAGS
# ================================================================
ENABLE_PROACTIVE_TRIGGERS=false
ENABLE_HUMAN_HANDOFF=false
ENABLE_ORDER_LOOKUP=true

# ================================================================
# OBSERVABILITY (Optional)
# ================================================================
SENTRY_DSN=
LOG_LEVEL=info

# ================================================================
# RATE LIMITING
# ================================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ================================================================
# DATA RETENTION (days)
# ================================================================
CONVERSATION_RETENTION_DAYS=365
BEHAVIOR_EVENT_RETENTION_DAYS=90

# ================================================================
# RELEASE METADATA (optional; injected by the build/deploy pipeline)
# ================================================================
SOURCE_VERSION=your_git_sha_here
COMMIT_SHA=your_git_sha_here
